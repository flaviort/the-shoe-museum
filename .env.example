# Optional. Copy to .env (never committed) and fill in only what you need.

# Theme Access token, for anyone who prefers it over the browser login.
# Store admin > Apps > Theme Access > create a password.
SHOPIFY_CLI_THEME_TOKEN=

# Only needed if the storefront is in Private mode
# (Online Store > Preferences > Store access > Private mode).
SHOPIFY_STOREFRONT_PASSWORD=
